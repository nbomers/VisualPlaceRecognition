# ---------- Ergebnisse ----------
# Je Stadt ein Zweig: results/<stadt>/... (src/paths.py). Versioniert sind
# die Recall- und Lokalisierungs-JSONs (KB), der Datensatz-Audit und die
# Abbildungen (~67 KB je Bild); Trefferlisten, Embeddings und Gewichte
# bleiben draussen.
#
# figures/coverage und figures/dataset sind seit dem README-Umbau nicht mehr
# pauschal ausgeschlossen -- der Daten-Abschnitt zeigt sie. Die Karten unter
# coverage/ koennen je nach Stadt mehrere MB gross werden: vor dem Hinzufuegen
# `du -sh results/<stadt>/figures/coverage` pruefen und im Zweifel nur die
# Hauptstadt des Projekts aufnehmen, nicht alle sechs.
/results/*
!/results/*/
/results/*/*
!/results/*/dataset_audit.json
!/results/*/evaluation/
/results/*/evaluation/*
!/results/*/evaluation/*.json
!/results/*/localization/
/results/*/localization/*
!/results/*/localization/*.json
!/results/*/figures/
/results/*/figures/*
!/results/*/figures/evaluation/
/results/*/figures/evaluation/*
!/results/*/figures/evaluation/*.png
!/results/*/figures/localization/
/results/*/figures/localization/*
!/results/*/figures/localization/*.png
!/results/*/figures/demo/
/results/*/figures/demo/*
!/results/*/figures/demo/*.png
!/results/*/figures/dataset/
/results/*/figures/dataset/*
!/results/*/figures/dataset/*.png
!/results/*/figures/coverage/
/results/*/figures/coverage/*
!/results/*/figures/coverage/*.png

# ---------- Sonstiges ----------
.cache/

# OSMnx-Cache (Overpass-Antworten)
cache/

# Ausnahme: die abgerufenen Mapillary-Detections. 6 MB fuer 11.942 Bilder,
# rund zwei Minuten API-Zeit -- gehoert zum Messergebnis in experiments/.
!cache/
cache/*
!cache/detections.jsonl

.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---------- Geklonte Fremd-Repos ----------
# AnyLoc, MixVPR, EigenPlaces, MegaLoc. Werden per git clone geholt,
# siehe README. Nie mitcommitten.
external/

# ---------- Modellgewichte ----------
weights/

# Je Stadt ein Zweig: data/<stadt>/{raw,processed,embeddings}. Versioniert
# sind nur Split-Listen und Metadaten (9 MB je Stadt) -- Zeilenreihenfolge
# und Mapillary-Schnappschuss sind Teil jedes Fingerabdrucks, nur so rechnet
# ein anderer Rechner dieselben Artefakte.
!data/*/
data/*/*
!data/*/processed/
data/*/processed/*
!data/*/processed/train_sequences.txt
!data/*/processed/database_sequences.txt
!data/*/processed/query_sequences.txt
!data/*/processed/metadata.parquet

# Arbeitsnotizen bleiben lokal. Verzeichnismuster: git steigt gar nicht
# erst hinein, eine Ausnahme fuer eine einzelne Datei darunter wuerde also
# ohnehin nicht greifen.
docs/
