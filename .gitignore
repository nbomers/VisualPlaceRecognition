# ---------- Python ----------
__pycache__/
*.so
build/
dist/
*.egg-info/
.eggs/

# ---------- Umgebungen ----------
.venv/
venv/
env/
ENV/
.conda/
envs/

# ---------- Jupyter ----------
.ipynb_checkpoints/
profile_default/
ipython_config.py

