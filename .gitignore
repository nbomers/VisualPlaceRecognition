# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/
.eggs/

# ---------- Umgebungen ----------
.venv/
venv/
env/
ENV/
.conda/
envs/

# ---------- Jupyter ----------
.ipynb_checkpoints/
profile_default/
